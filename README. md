select upper(first_name) from hr.EMPLOYEES;  
select lower(first_name) from hr.EMPLOYEES;  
select initcap(first_name) from hr.EMPLOYEES;  
select length(first_name) from hr.EMPLOYEES;  
select first_name as ad, upper(first_name) as ad_boyuk_hrflerle from hr.EMPLOYEES;  				
select salary as maash, salary*12 as illik_maash from hr.EMPLOYEES;  
select phone_number as kohne_nomre, concat('+',phone_number) as yeni_nomre from hr.employees;  
--select * from hr.employees;  										
select initcap(first_name)||' '||initcap(last_name)||' '||initcap(job_id) as ad_soyad_is from	hr.EMPLOYEES;  
select phone_number||'-'||length(phone_number) from hr.employees;  
select substr(first_name,1,2) from hr.employees;  
select trim('*' from '*123*') from dual;  
select ltrim('*-firstname','*-') from dual;  
select rtrim('*-firstname*','*') from dual;  
select lpad(123,6,'*') from dual;  
select rpad(123,6,'*') from dual;  
select * from hr.employees order by department_id asc, salary asc;  
select first_name as ad, last_name as soyad, department_id as sobe_kodu from hr.employees order by manager_id, salary desc;  
select trim(leading substr(job_id,1,1) from job_id) as yeni_job_id from hr.employees;  
select ltrim(job_id, substr(job_id,1,1)) as yeni_job_id from hr.employees;  
select count(*) from hr.employees where commission_pct is null;  
select count(*) from hr.employees where commission_pct is not null;  
select first_name ,substr(concat(manager_id, department_id),-5) from hr.employees;  
select * from hr.employees order by hire_date desc;  
select ltrim(postal_code,0) from hr.locations;  
